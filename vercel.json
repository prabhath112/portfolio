{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "sh scripts/build-root.sh",
  "outputDirectory": "dist/portfolio/browser",
  "rewrites": [{ "source": "/((?!.*\\.).*)", "destination": "/index.csr.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/resume.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Prabhath_Kumar_Resume.pdf\"; filename*=UTF-8''Prabhath%20Kumar%27s%20Resume.pdf" }
      ]
    },
    {
      "source": "/(.*)-([A-Z0-9]{8}).(js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
